# Copia este archivo como .env y cambia los valores.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://auth:auth@localhost:55435/auth
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
CORS_ORIGINS=http://localhost:4200
ACCESO_MINUTOS=15
RENOVACION_DIAS=30
LIMITE_POR_MINUTO=30
# Número de proxies delante (Render, Nginx...) para que req.ip sea la IP real.
TRUST_PROXY=
